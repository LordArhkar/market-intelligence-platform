# Market Intelligence Platform Configuration

# Application
APP_NAME="Market Intelligence Platform"
APP_VERSION="0.1.0"
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=development
OPERATING_MODE=VALIDATION  # VALIDATION or TOURNAMENT

# Paths
DATA_DIR="./data"
CACHE_DIR="./data/cache"
OUTPUT_DIR="./output"
LOGS_DIR="./logs"

# Database (PostgreSQL with TimescaleDB)
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/mip"

# Redis
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_DB=0

# Market Data Providers

## Yahoo Finance (free)
YFINANCE_ENABLED=true

## CCXT (crypto)
CCXT_ENABLED=true
CCXT_DEFAULT_EXCHANGE="binance"

## Alpaca (US equities - requires API key)
# ALPACA_ENABLED=false
# ALPACA_KEY="your_key_here"
# ALPACA_SECRET="your_secret_here"
# ALPACA_PAPER=true

## Polygon (US equities, options - requires API key)
# POLYGON_ENABLED=false
# POLYGON_API_KEY="your_key_here"

# Risk Management
MAX_POSITION_RISK_PERCENT=2.0
MAX_PORTFOLIO_RISK_PERCENT=6.0
MAX_DAILY_LOSS_PERCENT=3.0
MAX_WEEKLY_LOSS_PERCENT=6.0
MAX_DRAWDOWN_PERCENT=15.0
MAX_LEVERAGE=1.0

# Execution
MODE=SIMULATOR
INITIAL_CAPITAL=100000.0
CURRENCY=USD
DEFAULT_SLIPPAGE_BPS=10.0

# UpsideOnly Integration
UPSIDEONLY_ENABLED=false
# UPSIDEONLY_API_KEY="your_key_here"
# UPSIDEONLY_CSV_PATH="./output/upsideonly"

# Note: Never store actual API keys in this file.
# Use environment variables or a secrets manager.
